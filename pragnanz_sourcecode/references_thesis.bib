@article{carter2014,
  title = {Using Ambiguous Plaid Stimuli to Investigate the Influence of Immediate Prior Experience on Perception},
  author = {Carter, Olivia and Snyder, Joel S. and Fung, Sandy and Rubin, Nava},
  year = {2014},
  volume = {76},
  pages = {133--147},
  issn = {1943-393X},
  doi = {10.3758/s13414-013-0547-5},
  abstract = {In a series of three experiments, we used an ambiguous plaid motion stimulus to explore the behavioral and electrophysiological effects of prior stimulus exposures and perceptual states on current awareness. The results showed that prior exposure to a stimulus biased toward one percept led to subsequent suppression of that percept. In contrast, in the absence of stimulus bias, prior perceptual experience can have a facilitative influence. The suppressive effects caused by the prior stimulus were found to transfer to an ambiguous plaid test stimulus rotated 180\textordmasculine{} relative to the adaptation stimulus, but were abolished if (1) the ambiguous test stimulus was only rotated 90\textordmasculine{} relative to the adaptation stimulus or (2) the adaptation stimulus was heavily biased toward the component grating percept. Event-related potential recordings were consistent with the involvement of visual cortical areas and suggested that the influence of recent stimulus exposure may involve recruitment of additional brain processes beyond those responsible for initial stimulus encoding. In contrast, the effects of prior and current perceptual experience appeared to depend on similar brain processes. Although the data presented here focus on vision, the work is discussed within the context of data from a parallel series of experiments in audition.},
  journal = {Attention, Perception, \& Psychophysics},
  keywords = {Audition,Electroencephalography,Motion,Multistability,Rivalry,Vision},
  language = {en},
  number = {1}
}

@article{chamberlain2016,
  title = {The Genesis of Errors in Drawing},
  author = {Chamberlain, Rebecca and Wagemans, Johan},
  year = {2016},
  journal = {Neuroscience \& Biobehavioral Reviews},
  volume = {65},
  pages = {195--207},
  issn = {0149-7634},
  doi = {10.1016/j.neubiorev.2016.04.002},
  abstract = {The difficulty adults find in drawing objects or scenes from real life is puzzling, assuming that there are few gross individual differences in the phenomenology of visual scenes and in fine motor control in the neurologically healthy population. A review of research concerning the perceptual, motoric and memorial correlates of drawing ability was conducted in order to understand why most adults err when trying to produce faithful representations of objects and scenes. The findings reveal that accurate perception of the subject and of the drawing is at the heart of drawing proficiency, although not to the extent that drawing skill elicits fundamental changes in visual perception. Instead, the decisive role of representational decisions reveals the importance of appropriate segmentation of the visual scene and of the influence of pictorial schemas. This leads to the conclusion that domain-specific, flexible, top-down control of visual attention plays a critical role in development of skill in visual art and may also be a window into creative thinking.},
  langid = {english},
  keywords = {Drawing,Perception,Top-down,Visual attention}
}


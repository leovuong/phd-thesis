@article{vanderhelm2000,
  title = {Simplicity versus Likelihood in Visual Perception: From Surprisals to Precisals},
  shorttitle = {Simplicity versus Likelihood in Visual Perception},
  author = {{van der Helm}, Peter A.},
  year = {2000},
  month = sep,
  journal = {Psychological Bulletin},
  volume = {126},
  number = {5},
  pages = {770--800},
  issn = {0033-2909},
  doi = {10.1037/0033-2909.126.5.770},
  abstract = {The likelihood principle states that the visual system prefers the most likely interpretation of a stimulus, whereas the simplicity principle states that it prefers the most simple interpretation. This study investigates how close these seemingly very different principles are by combining findings from classical, algorithmic, and structural information theory. It is argued that, in visual perception, the two principles are perhaps very different with respect to the viewpoint-independent aspects of perception but probably very close with respect to the viewpoint-dependent aspects which, moreover, seem decisive in everyday perception. This implies that either principle may have guided the evolution of visual systems and that the simplicity paradigm may provide perception models with the necessary quantitative specifications of the often plausible but also intuitive ideas provided by the likelihood paradigm.},
  langid = {english},
  pmid = {10989623},
  keywords = {Gestalt Theory,Humans,Models; Psychological,Probability Theory,Visual Perception}
}

@article{vanderhelm2017,
  ids = {vanderhelm2017b},
  title = {On {{Bayesian}} simplicity in Human Visual Perceptual Organization},
  author = {{van der Helm}, Peter A.},
  year = {2017},
  month = nov,
  journal = {Perception},
  volume = {46},
  number = {11},
  pages = {1269--1282},
  issn = {0301-0066, 1468-4233},
  doi = {10.1177/0301006617719604},
  abstract = {A returning idea among some Bayesians in research on human visual perceptual organization is that the surprisal of something (i.e., the negative logarithm of its probability) expresses its complexity (i.e., the length of its shortest description). Bayes' rule is a powerful modeling tool and descriptive simplicity is a rich concept, but this idea is wishful thinking at best: If true, it would unify the simplicity and likelihood principles, which reflect two traditionally opposed schools of thought on perceptual organization. Some rapprochement between the two principles can certainly be discerned, but the aforementioned idea lacks formal underpinning and confounds otherwise perfectly good ideas. Here, this idea is revisited and its latest version is debunked step by step. In addition, I argue that its likely origin lies, inadvertently, in a standard Bayesian textbook: The author made (a) a pivotal mistake and (b) a compelling argument that was overinterpreted by others.},
  langid = {english}
}

@unpublished{vanderhulst2022prox,
  ids = {vanderhulst2020},
  title = {Grouping by Proximity and Luminance Similarity Is Additive for Everyone: {{An}} Analysis of Individual Differences in Grouping Sensitivity},
  shorttitle = {Grouping by Proximity and Luminance Similarity},
  author = {{Van der Hulst}, Elisabeth and {van Heusden}, Elle and Wagemans, Johan and Moors, Pieter},
  year = {2022},
  month = sep,
  publisher = {{Retrieved from osf.io/p845j}},
  abstract = {It has previously been shown that grouping by proximity is well describedby a purely linear function relating the ratio of the distances between theelements constituting the stimulus and the preference of organizing the stim-ulus along a particular distance. Similarly, luminance similarity influenceshow observers perceptually group stimuli, and it has been shown that prox-imity and luminance similarity interact additively. That is, their effects canbe summed in order to predict an observers' percept. This is an interestingobservation as it contrasts with the famous saying from Gestalt psychology:the whole is more and/or different than the sum of its parts. In this study,we revisit the additive interplay between proximity and luminance similarityand we ask whether this pattern might be the result of inappropriately aver-aging differenttypesof observers (e.g., super-additive grouping vs. no effectof luminance similarity). To address this question, we ran a replication ofthe original study that reported the additive interplay between proximityand luminance similarity.  Our results showed a convincing replication atthe aggregate level.  At the individual level,all observersshowed group-ing by proximity whereassome observersdid not show grouping by lumi-nance similarity. Interestingly, we observed a correlation between groupingby proximity and luminance similarity. Observers that relied more stronglyon proximity also relied more strongly on luminance similarity. This findingcould suggest that there is a general capacity for perceptual grouping andthat some individuals exploit grouping cues more strongly than others whenpresented with a visual display. All code and data at https://osf.io/p845j/.},
  langid = {english}
}


  title = {\textit{{Beitr\"age zur Psychologie der Gestalt. VI. \"Uber die Ver\"anderung yon Vorstellungen (Ged\"achtnis und Gestalt)}} [{C}ontributions to the Psychology of {G}estalt. {VI.} {O}n the change of ideas
(Memory and {G}estalt)]},
  author = {Wulf, Friedrich},

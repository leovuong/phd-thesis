@article{shier2011,
  title = {Filling Space with Random Fractal Non-Overlapping Simple Shapes},
  author = {Shier, John},
  date = {2011},
  pages = {10},
  abstract = {We present an algorithm that randomly places simple shapes (circles, squares, triangles, and others) without overlap in two dimensions. We describe the mathematics of the process in detail with some conjectures about its properties. The distribution of the areas of the shapes is a power law with varying exponents (typically around -1.3 for visual art). When the algorithm continues "to infinity" it fills all space, while the shapes have an infinite total perimeter. We show several uses of this algorithm to produce visual art.},
  language = {en}
}

@article{shier2013,
  title = {An Algorithm for Random Fractal Filling of Space: An Algorithm for Random Fractal Filling of Space},
  shorttitle = {An {{Algorithm}} for {{Random Fractal Filling}} of {{Space}}},
  author = {Shier, John and Bourke, Paul},
  year = {2013},
  journal = {Computer Graphics Forum},
  volume = {32},
  number = {8},
  pages = {89--97},
  issn = {01677055},
  doi = {10.1111/cgf.12163},
  abstract = {Computational experiments with a simple algorithm show that it is possible to fill any spatial region with a random fractalization of any shape, with a continuous range of pre-specified fractal dimensions D. The algorithm is presented here in 1, 2, or 3 physical dimensions. The size powerlaw exponent c or the fractal dimension D can be specified ab initio over a substantial range. The method creates an infinite set of shapes whose areas (lengths, volumes) obey a power law and sum to the area (length, volume) to be filled. The algorithm begins by randomly placing the largest shape and continues using random search to place each smaller shape where it does not overlap or touch any previously placed shape. The resulting gasket is a single connected object.},
  language = {en}
}


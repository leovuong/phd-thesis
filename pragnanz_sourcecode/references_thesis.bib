@article{vanleeuwen1990,
  title = {Perceptual-Learning Systems as Conservative Structures: {{Is}} Economy an Attractor?},
  shorttitle = {Perceptual-Learning Systems as Conservative Structures},
  author = {{van Leeuwen}, Cees},

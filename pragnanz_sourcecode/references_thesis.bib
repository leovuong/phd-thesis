@article{cohen1997,
  title = {Why Can't Most People Draw What They See?},
  author = {Cohen, Dale J. and Bennett, S.},
  year = {1997},
  journal = {Journal of Experimental Psychology. Human Perception and Performance},
  volume = {23},
  number = {3},
  pages = {609--621},
  issn = {0096-1523},
  doi = {10.1037//0096-1523.23.3.609},
  abstract = {The study presented a theoretical and empirical approach to the adult drawing process. Four possible sources of drawing inaccuracies were described: misperception of the object, inability to make good representational decisions, deficient motor skills, and misperception of the drawing. In four studies the degree to which the latter three sources contributed to drawing inaccuracies was assessed. The results suggest that (a) motor coordination is a very minimal source of drawing inaccuracies, (b) the artist's decision-making process is a relatively minor source of drawing inaccuracies, and (c) the artist's misperception of his or her work is not a source of drawing inaccuracies. These results suggest that the artist's misperception of the object is the major source of drawing errors.},
  langid = {english},
  pmid = {9180037},
  keywords = {Art,Delusions,Humans,Motor Skills,Optical Illusions,Visual Perception}
}

@article{cohen2005,
  title = {Look Little, Look Often: {{The}} Influence of Gaze Frequency on Drawing Accuracy},
  shorttitle = {Look Little, Look Often},
  author = {Cohen, Dale J.},
  year = {2005},
  journal = {Perception \& Psychophysics},
  volume = {67},
  number = {6},
  pages = {997--1009},
  issn = {1532-5962},
  doi = {10.3758/BF03193626},
  abstract = {The present article attempts to determine what those who draw accurately do differently than those who do not. Four experiments explore the relation between drawing accuracy and the rate at which artists glance between their drawing and the stimulus (termedgaze frequency). Experiment 1 revealed a positive relation between gaze frequency and drawing accuracy (r2=.33). Experiments 2, 3, and 4 demonstrated that gaze frequency directly influences drawing accuracy. High gaze frequencies may facilitate drawing accuracy by (1) allowing the artist to hold less information in working memory, (2) reducing memory distortion, and (3) facilitating the reduction of context effects through inattentional blindness.},
  langid = {english}
}


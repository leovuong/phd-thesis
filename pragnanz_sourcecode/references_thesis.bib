@misc{long2021,	
  type = {Preprint},
  title = {Parallel Developmental Changes in Children's Production and Recognition of Line Drawings of Visual Concepts},
  author = {Long, Bria and Fan, Judith E. and Huey, Holly and Chai, Zixian and Frank, Michael C.},
  year = {2021},
  publisher = {{PsyArXiv}},
  doi = {10.31234/osf.io/5yv7x},
  abstract = {How do visual concepts, such as dogs, cars, and clocks, change throughout childhood? We hypothesized that as children learn how to best distinguish visual concepts from one another, children's ability to connect this knowledge with external representations of visual concepts expressed in line drawings also improves. To examine this possibility, we investigated developmental changes in children's ability to produce and recognize the category-diagnostic information in drawings of common visual concepts. First, we recruited children aged 2-10 years to produce drawings of 48 categories via a free-standing kiosk in a children's museum, resulting in a corpus containing {$>$}37K drawings. Second, we recruited other children across the same age range to identify the drawn category in a subset of these drawings via "guessing games'' at the same kiosk. We analyzed changes in the category-diagnostic information conveyed in these drawings using both a deep convolutional neural network model of object recognition and annotations of the object parts in a subset of drawings. We found consistent developmental gains in both children's ability to include category-diagnostic information in their drawings and in their ability to use this same visual information to recognize other children's drawings. Our results suggest that children's ability to connect internal and external representations of visual concepts improves gradually across childhood and imply that developmental trajectories of visual concept learning may be more protracted than previously thought.},
  langid = {american},
  keywords = {Cognitive development,Cognitive Psychology,Concepts and Categories,Deep neural networks,Drawings,Object recognition,Perception,Social and Behavioral Sciences,Vision,Visual concepts,Visual development}
}

@misc{long2022,	
  type = {Preprint},
  title = {Developmental Consistency in Children's Drawings of Object Categories},
  author = {Long, Bria and Wang, Ying and Christie, Stella and Frank, Michael C. and Fan, Judith E.},
  year = {2022},
  publisher = {{PsyArXiv}},
  doi = {10.31234/osf.io/fpebs},
  abstract = {Children's drawings of common object categories become dramatically more recognizable across development. What are the major factors that explain this developmental change? Here we examined the degree to which these developmental changes in recognizability vary across different drawing tasks (i.e. drawing from observation vs. from memory), geographical locations (San Jose, US vs. Beijing, China), and with children's tracing abilities. To do so, we collected digital drawings of object categories (e.g., cat, airplane) from 4\textendash 9-year-olds (N=253). We found that the developmental trajectory of drawing recognizability was remarkably similar when children were asked to draw from observation vs. memory and across these two geographical locations. In addition, we found that our Beijing sample produced more recognizable drawings but showed similar tracing abilities to children from San Jose, USA. Overall, this work suggests that the developmental trajectory of children's drawings is remarkably consistent and not easily explainable by changes in visuomotor control or working memory.},
  langid = {american},
  keywords = {Cognitive Development,Developmental Psychology,Social and Behavioral Sciences}
}

